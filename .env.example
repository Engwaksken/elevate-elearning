# -----------------------------------------------------------------------------
# Elevate Her 360 eLearning - environment settings
#
# Copy this file to .env and fill in real values. Never commit .env.
#
# Where to put .env: the app looks in the project folder, then in each parent
# folder (up to 4 levels); the nearest file wins.
#   Recommended: /home/<user>/.env  (outside the public web folder), which works
#   for /home/<user>/public_html and /home/<user>/public_html/elearning alike.
#   Then: chmod 600 ~/.env
#
# Quoting: wrap passwords in SINGLE quotes so #, $, \ and spaces are kept
# exactly:  EH_MAIL_PASSWORD='p@ss#word'
# Check mail settings with:  php scripts/cli/test_mail.php
# Real environment variables set by the host override this file.
# -----------------------------------------------------------------------------

# --- Site --------------------------------------------------------------------
# Base URL used in email links (no trailing slash).
EH_APP_URL=https://www.elevateher360.org
EH_ACCOUNTS_EMAIL=info@elevateher360.org

# --- Database ----------------------------------------------------------------
EH_DB_HOST=localhost
EH_DB_USER=
EH_DB_PASS=
EH_DB_NAME=

# --- Mail (global SMTP for all system emails) ---------------------------------
# When EH_MAIL_HOST is set, these settings are used for every email and the
# email_settings database table is ignored. Leave EH_MAIL_HOST empty to keep
# using the database table.
# EH_MAIL_ENCRYPTION: ssl (usually port 465), tls (usually port 587) or none.
EH_MAIL_HOST=
EH_MAIL_PORT=465
EH_MAIL_ENCRYPTION=ssl
EH_MAIL_USERNAME=
# Full email address for cPanel mail. Password in single quotes.
EH_MAIL_PASSWORD=''
EH_MAIL_FROM_ADDRESS=no-reply@elevateher360.org
EH_MAIL_FROM_NAME="Elevate Her 360 eLearning"

# --- Single sign-on / unified auth (shared with the portal) -------------------
# Generate a secret with: openssl rand -hex 32  (must match the portal)
EH_SSO_SECRET=
EH_SSO_DOMAIN=.elevateher360.org
EH_SSO_TTL=86400
EH_AUTH_PUBLIC_BASE=
EH_AUTH_PORTAL_BASE=
EH_AUTH_PUBLISH_URL=
EH_AUTH_PUBLISH_TOKEN=
# 1 = local email/password login allowed, 0 = redirect to the portal only
EH_ELEARNING_LOCAL_LOGIN=1

# --- Upload compression -------------------------------------------------------
# 0 disables compression of uploaded images/PDFs.
EH_UPLOAD_COMPRESSION=1
# Full path to Ghostscript if it is not auto-detected (PDF compression).
EH_GHOSTSCRIPT=
# screen | ebook | printer | prepress
EH_PDF_QUALITY=ebook
